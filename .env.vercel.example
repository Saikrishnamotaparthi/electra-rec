# ============================================================
# Vercel project env vars (Dashboard → Settings → Environment Variables)
# Local .env is used by Vite only. Set these on Vercel for API routes.
# ============================================================

# Required for /api/applications (create + confirmation email) and resend
GMAIL_USER=your-club-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Required for /api/applications (Firestore write + emailStatus) and admin resend auth
# Firebase Console → Project Settings → Service accounts → Generate new private key
# Paste the entire JSON as one line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Optional: comma-separated admin emails allowed to resend emails
# ADMIN_EMAILS=hello@dotfreelancer.in,gelectra@gitam.edu
